---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SocialLinks, SITE_BASE } from '../consts'
import { Icon } from 'astro-icon/components'
import BlogCard from '../components/BlogCard.astro'
import { getCollection } from 'astro:content'
import heroImage from '../assets/hero/pexels-googledeepmind-18069813.jpg'

// Get the 4 latest blog posts from Astro content
const allPosts = await getCollection('blog')
const posts = allPosts
	.sort((a, b) => {
		const dateA = a.data?.pubDate ? a.data.pubDate.valueOf() : Date.now()
		const dateB = b.data?.pubDate ? b.data.pubDate.valueOf() : Date.now()
		return dateB - dateA
	})
	.slice(0, 4)
---

<BaseLayout>
	<main
		class="app-container grid lg:grid-cols-2 gap-12 lg:gap-16 items-center py-36 md:py-48 pt-44 md:pt-56 relative"
	>
		<div class="space-y-8">
			<p class="block text-3xl opacity-70 mb-4">👋 Hi, I'm</p>
			<h1 class="text-8xl font-bold leading-none">Greivin Cruz</h1>
			<p class="text-2xl max-w-2xl font-light leading-normal">
				JavaScript FullStack Developer & AI Enthusiast from San José, Costa Rica
			</p>
			<div class="flex flex-wrap gap-8 mt-6">
				{
					SocialLinks.map((link) => (
						<a
							class="text-xl text-primary dark:text-primary-dark underline hover:underline underline-offset-4"
							href={link.url}
							target="_blank"
						>
							{link.name}
						</a>
					))
				}
			</div>
		</div>
		<div class="flex justify-center lg:justify-end mt-8 lg:mt-0">
			<img
				src={heroImage.src}
				srcset={heroImage.src}
				sizes="(max-width: 768px) 100vw, 560px"
				alt="AI generated abstract neural network visualization"
				class="w-full max-w-[560px] h-[400px] object-cover rounded-lg shadow-lg"
				loading="eager"
				width={560}
				height={400}
			/>
		</div>
	</main>

	<!-- Recent Posts Section -->
	<section class="app-container">
		<h2 class="section-title">Articles of Interest</h2>
		<div class="posts-grid-container">
			{posts.map((post: any) => <BlogCard post={post} />)}
		</div>
		<a class="btn-secondary" href={`${SITE_BASE}blog`}
			>Read All
			<Icon size={20} name="mdi:arrow-right" />
		</a>
	</section>

	<!-- Recent Posts Section -->
	<section class="app-container py-42 grid lg:grid-cols-2 gap-28 lg:gap-10">
		<div class="space-y-6">
			<h2 class="section-title">About Me</h2>
			<p class="text-lg max-w-xl pb-4">
				Passionate software developer with expertise in full-stack JavaScript
				development and AI. Specializing in modern web applications using
				React.js, Vue.js, Node.js, and .NET Core. Currently working with
				Progranet & Bemantis Technologies in Costa Rica.
			</p>
			<a class="btn-secondary" href={`${SITE_BASE}about`}
				>Go to About
				<Icon size={20} name="mdi:arrow-right" />
			</a>
		</div>
		<div class="space-y-6">
			<h2 class="section-title">Get in touch</h2>
			<p class="text-lg max-w-xl">
				Interested in collaborating on Node.js projects or exploring new
				technologies.
			</p>
			<div class="flex flex-wrap mt-auto space-x-4">
				<a class="btn-primary" href="mailto:gcruzr@gmail.com" target="_blank"
					>Email Me
					<Icon height={20} name="mdi:email" />
				</a>
				<a
					class="btn-secondary"
					href="https://github.com/gcruzrios"
					target="_blank"
					>Visit GitHub
					<Icon height={20} name="mdi:github" />
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
