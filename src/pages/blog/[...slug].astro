---
import { type CollectionEntry, getCollection } from 'astro:content'
import BlogPostLayout from '../../layouts/BlogPostLayout.astro'


export async function getStaticPaths() {
	// Get only Astro content posts
	const astroPosts = await getCollection('blog')
	
	// Process Astro posts with headings
	const astroPaths = await Promise.all(
		astroPosts.map(async (post) => {
			const data = await post.render()
			return {
				params: { slug: post.slug },
				props: { 
					post, 
					headings: data.headings, 
					slug: post.slug,
					isWordPressPost: false
				}
			}
		})
	)
	
	return astroPaths
}

const { post, headings, slug } = Astro.props

// Handle content rendering for Astro content posts only
const astroPost = post as CollectionEntry<'blog'>
const renderResult = await astroPost.render()
const Content = renderResult.Content
const postData = astroPost.data
const remarkPluginFrontmatter = renderResult.remarkPluginFrontmatter
---

<BlogPostLayout
	{...postData}
	headings={headings}
	slug={slug}
	remarkPluginFrontmatter={remarkPluginFrontmatter}
>
	<Content />
</BlogPostLayout>
