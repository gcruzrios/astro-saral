---
import { SITE_BASE } from '@/consts'

	const { post } = Astro.props

	// Extract properties from Astro content
	const title = post.data?.title || 'Untitled'
	const excerpt = post.data?.description || ''
	
	// Only render if we have valid content
	const hasValidContent = title && title !== 'Untitled'
---

{hasValidContent && (
	<a
		href={`${SITE_BASE}blog/${post.slug}/`}
		class="block p-4 group transition-colors border border-gray-200 dark:border-gray-700 rounded-lg hover:shadow-md"
	>
		<div>
			<h4
				class="text-lg font-semibold group-hover:text-primary dark:group-hover:text-primary-dark group-hover:underline transition-colors"
			>
				{title}
			</h4>
			{excerpt && (
				<p class="line-clamp-3 opacity-80 text-sm leading-relaxed mt-1">
					{excerpt}
				</p>
			)}
		</div>
	</a>
)}
