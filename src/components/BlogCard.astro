---
import { SITE_BASE } from '@/consts'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

const { post } = Astro.props

// Extract properties from Astro content
const title = post.data?.title || 'Untitled'
const excerpt = post.data?.description || ''
const coverImage = post.data?.coverImage

// Try to resolve a local asset under /src/assets/blogimages/<slug>/cover.jpg
const blogImages = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/blogimages/**/*.{jpeg,jpg,png,gif}'
)
const coverImagePath = `/src/assets/blogimages/${post.slug}/cover.jpg`
let coverAsset: null | (() => Promise<{ default: ImageMetadata }>) = null
if (blogImages[coverImagePath]) {
	coverAsset = blogImages[coverImagePath]
}

// Only render if we have valid content
const hasValidContent = title && title !== 'Untitled'
---

{
	hasValidContent && (
		<a
			href={`${SITE_BASE}blog/${post.slug}/`}
			class="block p-4 group transition-colors border border-gray-200 dark:border-gray-700 rounded-lg hover:shadow-md"
		>
			{(coverAsset || coverImage) && (
				/* cover image kept inside card padding to match example; prefer optimized local asset */
				<div class="mb-3 overflow-hidden rounded-lg aspect-video">
					{coverAsset ? (
						<Image
							src={coverAsset()}
							alt={title}
							class="w-full h-full object-cover rounded-lg"
							loading="lazy"
						/>
					) : (
						<img
							src={coverImage}
							alt={title}
							class="w-full h-full object-cover rounded-lg"
							loading="lazy"
						/>
					)}
				</div>
			)}
			<div class="flex items-start gap-3">
				{/* small thumbnail removed */}
				<div class="flex-1 min-w-0">
					<h4 class="text-lg font-semibold group-hover:text-primary dark:group-hover:text-primary-dark group-hover:underline transition-colors">
						{title}
					</h4>
					{excerpt && (
						<p class="line-clamp-3 opacity-80 text-sm leading-relaxed mt-2">
							{excerpt}
						</p>
					)}
				</div>
			</div>
		</a>
	)
}
