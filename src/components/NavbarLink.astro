---
import type { HTMLAttributes } from 'astro/types'
import { SITE_BASE } from '../consts'

type Props = HTMLAttributes<'a'>

const { href, class: className, ...props } = Astro.props

const { pathname } = Astro.url
// For production deployed to /blog/ subdirectory, posts are at root level
// For development, posts are in /blog/ directory
const blogUrlPrefix = SITE_BASE.endsWith('/blog/') ? SITE_BASE.slice(0, -6) : `${SITE_BASE}blog`
const blogPath = blogUrlPrefix
const isActive =
	href === pathname ||
	href === pathname.replace(/\/$/, '') ||
	(pathname.startsWith(blogPath) && href === blogPath)
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	@reference "../styles/global.css";

	a {
		@apply underline-offset-4 hover:underline relative decoration-2;
	}
	a.active {
		@apply underline text-primary dark:text-primary-dark;
	}
</style>
